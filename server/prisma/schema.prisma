generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  timezone         String             @default("UTC")
  slotMinutes      Int                @default(30)
  slots            Slot[]
  bookings         Booking[]
  users            User[]
  availabilityRules AvailabilityRule[]
}

model Slot {
  id        String   @id @default(cuid())
  tenantId  String
  startsAt  DateTime
  endsAt    DateTime
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking   Booking?

  @@index([tenantId, startsAt])
}

model Booking {
  id         String @id @default(cuid())
  tenantId   String
  slotId     String @unique
  guestName  String
  guestEmail String
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slot       Slot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id           String        @id @default(cuid())
  userId       String
  tokenHash    String        @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id])
  replaced     RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId])
}

model AvailabilityRule {
  id        String @id @default(cuid())
  tenantId  String
  weekday   Int
  startMin  Int
  endMin    Int
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, weekday])
}
