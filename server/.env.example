# Neon: run `neon env pull` at the repo root (writes DATABASE_URL to `.env.local`).
# Prisma and the server load `.env.local` after this file so DATABASE_URL can live only at the root.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
PORT=5000
CLIENT_ORIGIN="http://localhost:5173"
